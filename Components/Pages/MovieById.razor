@page "/movie/{movieId:int}"

@implements IDisposable
@inject ITmdbService tmdbService

@if (movie is not null)
{
    <PageTitle>@movie.Title Details</PageTitle>
}

<div class="container-fluid p-0">
    @if(movie is null)
    {
        <div class="py-5 justify-content-center align-items-center">
            @if (isLoading)
            {
                <h2 class="text-muted">Loading...</h2>
            }
            else
            {
                <h2 class="text-muted">
                    The requested movie was not found
                </h2>
            }
        </div>
    }
    else
    {
        <div id="moviedetails-background" style="--movie-details-background: url(@movie.BackdropPath)">
            <div id="moviedetails-wrapper" class="">
                <div class="container-xxl py-3">
                    <div class="row">
                        <div class="col-12 col-md-6 col-xl-3 text-center text-md-start mb-3">
                            <img class="img-fluid" id="moviedetails-poster" alt="movie poster" src="@movie.PosterPath" />
                        </div>
                        <div class="col-12 col-md-6 col-xl-9">
                            <h3 class="display-6 fw-bold mb-0">@movie.Title</h3>
                            <div class="lead mb-3">
                                @movie.Tagline
                            </div>
                            <div class="hstack gap-2">
                                <span>@movie.ReleaseDate | </span>
                                <span>
                                @{
                                        int hours = movie.Runtime / 60;
                                        int minutes = movie.Runtime % 60;
                                    }
                                    Runtime: @hours hour(s) @minutes minutes.
                                </span>
                            </div>
                            <div class="hstack gap-2 my-2">
                                @foreach(var genre in movie.Genres)
                                {
                                    <span class="badge text-bg-primary">@genre.Name</span>
                                }
                            </div>
                            <h5 class="lead fw-bold pt-3 mt-3">Overview</h5>
                            <p>@movie.Overview</p>
                            <div>
                                <span id="moviedetails-rating">
                                    User score: @((movie.VoteAverage * 10).ToString("F2")) % by @movie.VoteCount users.
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(movieTrailer?.Key))
                            {
                                <div id="btn-movietrailer" class="mt-3">
                                    <button class="btn btn-outline-warning"
                                            data-bs-toggle="modal"
                                            data-bs-target="#moviedetails-modal"
                                    ><i class="bi bi-play" /> Play trailer
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal" tabindex="-1" id="moviedetails-modal">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content modal-background">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title">Movie Title</h5>
                <button type="button" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x" />
                </button>
            </div>
            <div class="modal-body">
                <div class="ratio ratio-16x9">
                    <iframe id="modal-trailer" src="" allowfullscreen>

                    </iframe>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-warning ms-auto" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@code {
    [Parameter]
    public int MovieId { get; set; }

    private MovieDetailsResponse? movie;
    private VideoResult? movieTrailer;
    private CancellationTokenSource cts = new CancellationTokenSource();
    bool isLoading;

    protected override async Task OnParametersSetAsync()
    {
        try{
            isLoading = true;
            movie = await tmdbService.GetMovieDetailsByIdAsync(MovieId, cts.Token);
            movieTrailer = await tmdbService.GetMovieTrailerAsync(MovieId, cts.Token);
        }catch(Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }


    public void Dispose()
    {
        if (cts != null)
        {
            cts.Cancel();
            cts.Dispose();
        }
    }
}
