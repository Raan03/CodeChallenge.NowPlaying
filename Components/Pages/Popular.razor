@page "/popular"
<PageTitle>Popular</PageTitle>

@inject ITmdbService tmdbService
@implements IDisposable

<div class="container-xxl py-3">
    <h1>
        <i class="bi bi-stars text-warning"></i>
        Popular
    </h1>
    <p class="lead italic">
        Movies that are currently popular with <a href="https://www.themoviedb.org/" class="link-warning">The Movie DB</a> users.
    </p>
    <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4">
        @if (popularMovies is null)
        {
            <div class="d-flex justify-content-center align-items-center">
                @if (isLoading)
                {
                    <h2 class="text-muted">Loading...</h2>
                }
                else
                {
                    <h2 class="text-muted">Failed to load...</h2>
                }
            </div>
        }
        else
        {
            @foreach (var movie in popularMovies.Results)
            {
                <div class="col">
                    <MovieCard Movie="@movie" />
                </div>
            }
        }
    </div>
</div>

@code {
    private NowPlayingResponseModel? popularMovies = null;
    private CancellationTokenSource cts = new CancellationTokenSource();
    private bool isLoading = true;

    override protected async Task OnInitializedAsync()
    {
        try
        {
            popularMovies = await tmdbService.GetPopularMoviesAsync(1, cts.Token);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        if (cts != null)
        {
            cts.Cancel();
            cts.Dispose();
        }
    }
}
